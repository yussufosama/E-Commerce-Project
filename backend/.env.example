PORT=5000
HOST=127.0.0.1
# Leave empty locally. Only exact IPs of your hosting reverse proxies belong here.
TRUSTED_PROXY_IPS=
MONGODB_URI=mongodb://127.0.0.1:27017/triple_seven
# Atlas or a replica set is required for checkout and password-change transactions.
NODE_ENV=development
APP_ORIGIN=http://127.0.0.1:5000
# Configure a real fee before accepting orders; 5000 means EGP 50.
SHIPPING_FEE_PIASTRES=
# Transactional email provider credentials (private .env only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
